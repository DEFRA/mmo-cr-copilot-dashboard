{
  "name": "mmo-cr-copilot-dashboard",
  "version": "0.0.0",
  "description": "Copilot analytics dashboard — React single page app served by a Hapi backend-for-frontend",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:frontend": "vite build",
    "dev": "AWS_EMF_ENVIRONMENT=Local npm run server:watch",
    "dev:debug": "AWS_EMF_ENVIRONMENT=Local npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"**/*.{js,jsx,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"**/*.{js,jsx,cjs,md,json,config.js,test.js}\"",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest run --coverage",
    "test:watch": "AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest",
    "security-audit": "npm audit --audit-level=moderate",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json,njk --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json,njk --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "imports": {
    "#/*": "./src/*",
    "#/test-helpers/*": "./test-helpers/*"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "0.6.1",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.0.2",
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "7.1.2",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "ioredis": "6.0.0",
    "joi": "18.2.5",
    "nunjucks": "3.2.4",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@defra/hapi-connect": "1.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "cheerio": "1.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-fetch-mock": "0.4.5"
  }
}
