{% extends 'layouts/page.njk' %}

{% block content %}
  {# Runtime configuration is passed as data attributes: an inline <script>
     would need 'unsafe-inline' in the Content-Security-Policy. #}
  <div
    id="root"
    data-poll-interval-ms="{{ pollIntervalMs }}"
    data-service-name="{{ serviceName }}"
    data-session-cookie-name="{{ sessionCookieName }}"
    data-session-cookie-ttl-hours="{{ sessionCookieTtlHours }}"
  ></div>
  <noscript>
    <div class="govuk-width-container">
      <main class="govuk-main-wrapper" id="main-content">
        <p class="govuk-body">
          The Copilot analytics dashboard needs JavaScript to render its charts.
          Enable JavaScript in your browser to view it.
        </p>
      </main>
    </div>
  </noscript>
{% endblock %}

{% block bodyEnd %}
  {% for src in scripts %}
    <script type="module" src="{{ src }}"></script>
  {% endfor %}
{% endblock %}
