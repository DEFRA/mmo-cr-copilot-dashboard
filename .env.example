# Every commented variable is optional and shown with the default from src/config/config.js.
# Uncomment only what you need to override.

# Ingest Authentication
# Required outside local development. Must match INGEST_TOKEN on the backend.
INGEST_TOKEN=local-development-ingest-token
# INGEST_MAX_PAYLOAD_BYTES=2097152
# Break-glass only: accept INGEST_TOKEN on POST /api/ingest from callers without GitHub OIDC.
# INGEST_ALLOW_SHARED_TOKEN=false

# GitHub Actions OIDC Ingest
# Numeric GitHub id of the DEFRA organisation; OIDC ingest is refused while empty.
# INGEST_OIDC_OWNER_ID=
# INGEST_OIDC_AUDIENCE=mmo-cr-copilot-dashboard
# Comma-separated; an override must keep both workflows or backfill tokens are rejected.
# INGEST_OIDC_WORKFLOW_REF_PREFIX=DEFRA/mmo-cr-devops-common/.github/workflows/copilot-analytics.yml@,DEFRA/mmo-cr-devops-common/.github/workflows/copilot-analytics-backfill.yml@
# INGEST_OIDC_ALLOWED_EVENTS=pull_request,workflow_dispatch
# INGEST_OIDC_SURVIVAL_WORKFLOW_REF_PREFIX=DEFRA/mmo-cr-devops-common/.github/workflows/copilot-analytics-survival.yml@
# INGEST_OIDC_SURVIVAL_ALLOWED_EVENTS=schedule,workflow_dispatch

# Entra ID Authentication
# Required outside local development (startup fails without them).
# To sign in with real Entra locally, set these and AUTH_DEV_BYPASS=false.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# Backend application (client) ID or App ID URI; scope name must match the backend.
# ENTRA_BACKEND_CLIENT_ID=
# ENTRA_BACKEND_SCOPE=access_as_user
# Must be https and registered on the app registration outside local development.
# ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback
# ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
# AUTH_TOKEN_REFRESH_SKEW_MS=300000
# AUTH_TOKEN_ENDPOINT_TIMEOUT_MS=10000
# Local development and tests only: sign in as a local persona instead of Entra.
AUTH_DEV_BYPASS=true

# Environment & Server
# ENVIRONMENT=local
# PORT=3000
# HOST=0.0.0.0
# LOG_ENABLED=true
# LOG_LEVEL=info
# LOG_FORMAT=pino-pretty
# LOG_REDACT=req.headers.authorization,req.headers.cookie,req.headers["x-ingest-token"],res.headers

# Backend Connection
# COPILOT_BACKEND_API_URL=http://localhost:3001
# BACKEND_REQUEST_TIMEOUT_MS=10000
# DASHBOARD_POLL_INTERVAL_MS=15000

# Sessions & Cache
# Required outside local development, where the shipped default below is rejected.
# SESSION_COOKIE_PASSWORD=the-password-must-be-at-least-32-characters-long
# SESSION_CACHE_ENGINE=memory
# SESSION_CACHE_NAME=session
# SESSION_CACHE_TTL=28800000
# SESSION_COOKIE_TTL=28800000
# SESSION_IDLE_TIMEOUT_MS=1800000
# SESSION_ABSOLUTE_TIMEOUT_MS=28800000
# SESSION_COOKIE_SECURE=false

# Redis (when SESSION_CACHE_ENGINE=redis)
# REDIS_HOST=127.0.0.1
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_KEY_PREFIX=mmo-cr-copilot-dashboard:
# USE_SINGLE_INSTANCE_CACHE=true
# REDIS_TLS=false

# Static & Shell
# STATIC_CACHE_TIMEOUT=604800000
# ASSET_PATH=/public

# Platform / CDP (injected in deployed environments)
# HTTP_PROXY=
# TRACING_HEADER=x-cdp-request-id
# SERVICE_VERSION=
# ENABLE_SECURE_CONTEXT=false
