# Environment & Server
ENVIRONMENT=local
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_FORMAT=pino-pretty

# Backend Connection
COPILOT_BACKEND_API_URL=http://localhost:3001
BACKEND_REQUEST_TIMEOUT_MS=10000
DASHBOARD_POLL_INTERVAL_MS=15000

# Ingest Authentication (Must match INGEST_TOKEN on the backend; required outside local development)
INGEST_TOKEN=local-development-ingest-token
INGEST_MAX_PAYLOAD_BYTES=2097152

# Sessions & Cache
SESSION_CACHE_ENGINE=memory
SESSION_CACHE_NAME=session
SESSION_CACHE_TTL=14400000
SESSION_COOKIE_PASSWORD=the-password-must-be-at-least-32-characters-long
SESSION_COOKIE_TTL=14400000
SESSION_COOKIE_SECURE=false

# Redis (When SESSION_CACHE_ENGINE=redis)
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_KEY_PREFIX=mmo-cr-copilot-dashboard:
USE_SINGLE_INSTANCE_CACHE=true
REDIS_TLS=false

# Static & Shell
STATIC_CACHE_TIMEOUT=604800000
ASSET_PATH=/public

# Platform / CDP (Set in deployed environments)
# HTTP_PROXY=
# TRACING_HEADER=x-cdp-request-id
# SERVICE_VERSION=
# ENABLE_SECURE_CONTEXT=false
